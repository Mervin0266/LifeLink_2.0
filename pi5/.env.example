# ==============================================================================
# LifeLink 2.0 - Raspberry Pi 5 Central Terminal Environment Configuration Template
# Copy to /etc/lifelink/lifelink.env or /opt/lifelink/.env and populate with production values.
# NEVER commit real patient keys, passwords, or encryption tokens to version control.
# ==============================================================================

# Operational Mode (Set MOCK_MODE=false and HARDWARE_MODE=true on physical Pi 5)
MOCK_MODE=false
HARDWARE_MODE=true
VALIDATION_MODE=false

# Server Settings
HOST=0.0.0.0
PORT=5000
SECRET_KEY=replace_with_64_char_random_flask_secret_key
JWT_SECRET_KEY=replace_with_64_char_random_jwt_secret_key
TOKEN_EXPIRATION_HOURS=8

# Local Database Settings (sqlite or postgresql)
DB_TYPE=sqlite
DB_NAME=lifelink_local.db

# PostgreSQL Settings (when DB_TYPE=postgresql)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=lifelink_app
POSTGRES_PASSWORD=replace_with_strong_local_postgres_password
POSTGRES_DB=lifelink

# Local Biometric Encryption Key (32-byte Base64-encoded key for AES-256-GCM)
# Generate with: python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
TEMPLATE_ENCRYPTION_KEY=dGVzdF9lbmNyeXB0aW9uX2tleV8zMl9ieXRlc19sb25nIQ==

# Wired Peripheral Hardware Connections
# (Provided by udev rule 99-lifelink.rules or /dev/serial/by-id/*)
ESP32_SERIAL_PORT=/dev/lifelink-fingerprint
ESP32_BAUD_RATE=115200

# Wired Pi Zero W Camera Link (USB Gadget Ethernet)
PIZERO_CAMERA_URL=http://192.168.55.2:5001
CAMERA_API_TOKEN=lifelink-wired-internal-camera-token

# Optional Supabase Cloud Synchronization
SYNC_ENABLED=false
SYNC_INTERVAL_SECONDS=30
SUPABASE_URL=https://your-hospital-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-private-service-role-key

# Iris Recognition Model Weights Paths
LIGHTIRISNET_WEIGHTS=/opt/lifelink/weights/best_mobilenetv3.pt
VIS_IRISFORMER_WEIGHTS=/opt/lifelink/weights/sota.pth

# LifeLink 2.0 Environment Configuration Template
# DO NOT COMMIT SENSITIVE PRODUCTION SECRETS OR REAL CREDENTIALS

# Operational Mode (true = developer mock mode, false = real physical hardware)
MOCK_MODE=true
HARDWARE_MODE=false
VALIDATION_MODE=false

# Server Settings
HOST=0.0.0.0
PORT=5000
SECRET_KEY=lifelink-mock-dev-secret-key-change-in-production
JWT_SECRET_KEY=lifelink-mock-jwt-secret-key-change-in-production

# Persistence Settings (sqlite for rapid local testing, postgresql for Pi 5 production)
DB_TYPE=sqlite
DB_NAME=lifelink_local.db
# PostgreSQL Connection (used when DB_TYPE=postgresql)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=lifelink_app
POSTGRES_PASSWORD=lifelink_secure_local_pw
POSTGRES_DB=lifelink

# Biometric Template Encryption Key (AES-256 base64 key: 32 bytes)
# In development mock mode, a deterministic test key is used if not provided.
TEMPLATE_ENCRYPTION_KEY=dGVzdF9lbmNyeXB0aW9uX2tleV8zMl9ieXRlc19sb25nIQ==

# Wired Hardware Link Settings
# ESP32 USB Serial port (discovered stably on Pi 5 via /dev/serial/by-id/*)
ESP32_SERIAL_PORT=/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller-if00-port0
ESP32_BAUD_RATE=115200

# Wired Camera Link (Raspberry Pi 3B+ over Dedicated Wired Ethernet)
CAMERA_SERVICE_URL=http://192.168.50.2:5000
CAMERA_REQUEST_TIMEOUT=30.0
CAMERA_DEVICE=raspberry-pi-3b-plus
CAMERA_API_TOKEN=lifelink-wired-internal-camera-token
# Backward compatibility alias for legacy Pi Zero W deployments
PIZERO_CAMERA_URL=http://192.168.50.2:5000

# Supabase Cloud Synchronization (Optional - only accessed over wired hospital Ethernet)
SUPABASE_URL=https://mock-lifelink.supabase.co
SUPABASE_ANON_KEY=mock-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=mock-service-role-key-placeholder
SYNC_INTERVAL_SECONDS=30
SYNC_ENABLED=false
